# Целевой сервис проекта — Petstore v3 (OpenAPI 3.0):
#   BASE_URL=https://petstore3.swagger.io/api/v3
# На 2026-08-14 v3 отдаёт 500 на запись, поэтому временно используется v2.
# Схемы данных у v2 и v3 идентичны, код правок не требует.
BASE_URL=https://petstore.swagger.io/v2
API_KEY=
TIMEOUT=10
RETRY_COUNT=2
